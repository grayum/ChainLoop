# ChainLoop
CHAINLOOP_HOST=chainloop.example.com
APP_BASE_URL=https://chainloop.example.com
DATABASE_URL=sqlite:////data/chainloop.db
# Required: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SESSION_SECRET=
# Canonical APP_BASE_URL hostname is always allowed; these support healthchecks.
CHAINLOOP_ALLOWED_HOSTS=127.0.0.1,localhost
# Development only: permits HTTP canonical URLs on localhost/127.0.0.1/::1.
CHAINLOOP_DEV_ALLOW_HTTP=false
# Loopback-only Strava mocks for explicit development/testing; never production.
CHAINLOOP_DEV_ALLOW_OUTBOUND_MOCKS=false

# Strava
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://chainloop.example.com/auth/strava/callback
STRAVA_SCOPES=activity:read_all
STRAVA_API_BASE_URL=https://www.strava.com/api/v3
STRAVA_VERIFY_TOKEN=replace-with-a-random-secret
STRAVA_AUTO_SYNC=true
STRAVA_SYNC_TIME=21:00
# Optional; when set, overrides STRAVA_SYNC_TIME with multiple daily runs.
STRAVA_SYNC_TIMES=
CHAINLOOP_TIMEZONE=Europe/Amsterdam

# Pushover
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
